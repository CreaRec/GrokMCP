# Docker image configuration
IMAGE=ghcr.io/crearec/grok-mcp-apple-calendar
IMAGE_TAG=main

# Apple iCloud CalDAV credentials
# Get an app-specific password from https://appleid.apple.com/account/manage
ICLOUD_CALDAV_USERNAME=your-icloud-email@icloud.com
ICLOUD_CALDAV_PASSWORD=xxxx-xxxx-xxxx-xxxx

# The full CalDAV URL for your calendar (find in Calendar.app → Calendars → right-click → Get Info)
# Example: https://caldav.icloud.com/12345678901/calendars/home/
ICLOUD_CALDAV_CALENDAR_URL=https://caldav.icloud.com/YOUR_USER_ID/calendars/YOUR_CALENDAR/

# Your local timezone (IANA format)
USER_TIMEZONE=America/Chicago

# OpenTelemetry configuration (metrics/logs → CreaGrafana Alloy)
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable telemetry; omit to disable.
# Requires external Docker network `lgtm` (create: docker network create lgtm)
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_SERVICE_NAME=apple-calendar
OTEL_SERVICE_NAMESPACE=mcp
DEPLOY_ENV=production
# OTEL_SERVICE_VERSION=sha-abc1234

# Grafana MCP configuration (grafana-mcp service)
# Create a Grafana service account: Configuration → Service accounts → Add service account
# Viewer role is sufficient for read-only queries; Editor/Admin for mutations.
GRAFANA_URL=http://grafana:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Bearer token callers must provide to authenticate to this MCP server
# MCP_GRAFANA_SERVER_TOKEN=your-caller-auth-token

# Search DB (search-db service) - pgvector PostgreSQL for Synology index
# These are required for the search-db container to start.
POSTGRES_USER=synology
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=synology_index

# DATABASE_URL for Prisma migrations (servers/search-index)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://synology:CHANGE_ME_strong_random_password@127.0.0.1:5434/synology_index
