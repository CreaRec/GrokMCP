# PostgreSQL connection string (required)
# The synology-db container uses pgvector; connect via Docker network or localhost.
# Docker network: postgresql://synology:YOUR_PASSWORD@synology-db:5432/synology
# Host network:   postgresql://synology:YOUR_PASSWORD@127.0.0.1:5434/synology
DATABASE_URL=postgresql://synology:CHANGE_ME@synology-db:5432/synology

# Transformers.js model cache directory (optional)
# First start downloads the mxbai-embed-large model (~500MB quantized).
# TRANSFORMERS_CACHE=/app/.cache/transformers

# OpenTelemetry configuration (metrics/logs → Alloy/Grafana)
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable telemetry; omit to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# OTEL_SERVICE_NAME=synology
# OTEL_SERVICE_NAMESPACE=mcp
# DEPLOY_ENV=production
# OTEL_SERVICE_VERSION=
