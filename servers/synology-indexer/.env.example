# Database connection (required, same as synology-mcp)
DATABASE_URL=postgresql://synology:CHANGE_ME@synology-db:5432/synology

# Mount root for Synology Documents (required)
# The NAS share mounted read-only on the host
MOUNT_ROOT=/mnt/synology/Documents

# Daily index schedule (optional)
# Time in HH:MM format in local timezone. Default: 21:00
INDEX_DAILY_AT=21:00

# Timezone for INDEX_DAILY_AT (default: America/Chicago)
TZ=America/Chicago

# Run once and exit instead of daily loop (optional)
# Set to "1" or "true" to run indexer once immediately
# RUN_ONCE=1

# RunPod GPU lifecycle (optional, recommended for production)
# Creates a fresh ephemeral pod when dirty files need vision, then terminates after processing.
# Saves GPU cost by not running idle GPU time.
# Pod is always terminated after processing unless RUNPOD_LEAVE_RUNNING=1.
# RUNPOD_API_KEY=your_runpod_api_key_never_logged
# Prefer a template when you have one configured in RunPod:
# RUNPOD_TEMPLATE_ID=your_template_id
# Or deploy from image (default ollama/ollama; models pulled via Ollama HTTP after boot):
# RUNPOD_IMAGE=ollama/ollama
# RUNPOD_CLOUD_TYPE=SECURE
# RUNPOD_GPU_TYPE_ID=NVIDIA GeForce RTX 4090
# RUNPOD_CONTAINER_DISK_GB=80
# Do not pin RUNPOD_DATA_CENTER_ID unless you must — pinning can strand pods on one host.
# RUNPOD_OLLAMA_PORT=11434
# RUNPOD_OLLAMA_HEALTHY_TIMEOUT_MS=600000
# RUNPOD_LEAVE_RUNNING=1  # Set to 1 to leave pod running after processing (for debugging)
# Retry pod create when fleet has no free GPUs (capacity errors only; not auth/TERMINATED).
# Defaults: 6 attempts, 120000 ms (~2 min) apart ≈ 10–12 minutes total.
# RUNPOD_START_RETRIES=6
# RUNPOD_START_RETRY_MS=120000
# Deprecated — ignored; pods are created ephemerally per session:
# RUNPOD_POD_ID=

# Ollama base URL (optional — direct Ollama only)
# Do NOT set when using RunPod ephemeral GPU. The indexer uses the RunPod HTTP proxy
# for the created pod (https://{podId}-{port}.proxy.runpod.net); a leftover
# OLLAMA_BASE_URL (e.g. old sticky-pod proxy) is ignored.
# If RunPod is not configured, set this to use an existing Ollama instance.
# OLLAMA_BASE_URL=http://localhost:11434

# Vision model for describing images/documents (optional)
# Models are pulled automatically if missing when using RunPod.
# VISION_MODEL=qwen2.5vl:7b

# Embedding model (optional, must match MCP query embeddings)
# Must be 1024-d to match MCP search embeddings (mxbai-embed-large).
# EMBED_MODEL=mxbai-embed-large

# Docling Serve sidecar for office/PDF document extraction (optional in dev, required for doc routes in prod)
# Streams files from the RO mount; markdown is sent to qwen as text (never images[]).
# In docker-compose the sidecar is ephemeral: synology-indexer starts it when a run has
# docling-routed dirty files, waits for /ready, converts, then stops the container.
# DOCLING_SERVE_URL=http://docling-serve:5001
# DOCLING_CONTAINER_NAME=grok-mcp-docling-serve
# DOCLING_HEALTHY_TIMEOUT_MS=300000
# DOCLING_PAGE_RANGE_END=5  # Gist: PDFs sliced to pages 1-N via qpdf temp file before Docling; others still use page_range 1-N
# DOCLING_CONVERT_TIMEOUT_MS=90000  # Client-side fail-fast if Docling hangs
# DOCLING_DOCUMENT_TIMEOUT_SEC=90  # Docling server-side per-document timeout
# DOCLING_LEAVE_RUNNING=1  # Leave sidecar up after processing (debugging)
# DOCKER_SOCKET_PATH=/var/run/docker.sock  # Mounted into synology-indexer in compose
# Host docker group GID — synology-indexer group_add in docker-compose.yml (default 995).
# On the host: stat -c %g /var/run/docker.sock   or   getent group docker
# DOCKER_GID=995

# Gist caps for qwen-text and docling markdown (one code path for all files)
# INDEX_TEXT_HEAD_BYTES=65536  # qwen-text: read only file head (~64 KiB)
# INDEX_QWEN_DOCUMENT_CHARS=32768  # Max excerpt chars sent to qwen
# INDEX_MAX_DESCRIPTION_CHARS=500  # Cap DESCRIPTION before mxbai embed

# OpenTelemetry (optional, same stack as synology-mcp)
# Requires external Docker network `lgtm` when running via docker-compose.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# OTEL_SERVICE_NAME=synology-indexer
# OTEL_SERVICE_NAMESPACE=mcp
# DEPLOY_ENV=production
# OTEL_SERVICE_VERSION=

# DSM share-link credentials (optional, from existing Debian indexer)
# Required to generate shareUrl for new files
# If missing, shareUrl will be null (MCP already skips null shareUrl)
# DSM_HOST=https://your-nas.example.com:5001
# DSM_SHARE_USER=share_user
# DSM_SHARE_PASSWORD=NEVER_LOG_THIS
