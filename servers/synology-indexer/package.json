{
  "name": "@crearec/synology-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily indexer for Synology NAS files - hashes, describes with vision models, and embeds into pgvector",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && npm run db:generate",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@crearec/otel": "^0.0.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@xenova/transformers": "^2.17.2",
    "debug": "^4.4.3",
    "pg": "^8.23.0",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "synology-indexer": "./dist/index.js"
  }
}
