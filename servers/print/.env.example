# CUPS server reachable from this container (host cupsd — not a nested cupsd).
# Production compose uses network_mode: host because debian-server cupsd is
# localhost-only (127.0.0.1:631). Bridge networks cannot reach it.
CUPS_SERVER=127.0.0.1:631

# Default CUPS queue name (lp -d …). Override per call with the printer tool arg.
CUPS_PRINTER=HP_LaserJet_Tank_2504dw
# DEFAULT_PRINTER=HP_LaserJet_Tank_2504dw

# Path jail for print_file path=/… and temp downloads/uploads/LibreOffice PDF conversions.
PRINT_SPOOL_DIR=/var/tmp/print-mcp

# Optional download limits for print_file url=…
# PRINT_DOWNLOAD_TIMEOUT_MS=30000
# PRINT_MAX_DOWNLOAD_BYTES=52428800

# HTTP upload (/print/upload) — prefer over contentBase64 for large Word/PDF files.
# When set, require Authorization: Bearer <token> or X-Print-Token on uploads.
# Generate on debian: openssl rand -hex 32  →  add to /home/crearec/grok-mcp/.env
# PRINT_UPLOAD_TOKEN=
# Optional dedicated upload size cap (defaults to PRINT_MAX_DOWNLOAD_BYTES).
# PRINT_MAX_UPLOAD_BYTES=52428800

# HTTP listen (production defaults)
# PORT=8797
# HOST=0.0.0.0

# OpenTelemetry configuration (metrics/logs → CreaGrafana Alloy)
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable telemetry; omit to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=print
# OTEL_SERVICE_NAMESPACE=mcp
# DEPLOY_ENV=local
# OTEL_SERVICE_VERSION=
