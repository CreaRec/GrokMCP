# CUPS server reachable from this container (host cupsd — not a nested cupsd).
# Prefer the debian host Tailscale/LAN IP, or docker bridge gateway / host.docker.internal.
# Examples:
#   CUPS_SERVER=100.x.x.x:631
#   CUPS_SERVER=172.17.0.1:631
#   CUPS_SERVER=host.docker.internal:631
CUPS_SERVER=172.17.0.1:631

# Default CUPS queue name (lp -d …). Override per call with the printer tool arg.
CUPS_PRINTER=HP_LaserJet_Tank_2504dw
# DEFAULT_PRINTER=HP_LaserJet_Tank_2504dw

# Path jail for print_file path=/… and temp downloads/uploads (mounted RO or RW in compose).
PRINT_SPOOL_DIR=/var/tmp/print-mcp

# Optional download limits for print_file url=…
# PRINT_DOWNLOAD_TIMEOUT_MS=30000
# PRINT_MAX_DOWNLOAD_BYTES=52428800

# HTTP listen (production defaults)
# PORT=8796
# HOST=0.0.0.0

# OpenTelemetry configuration (metrics/logs → CreaGrafana Alloy)
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable telemetry; omit to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=print
# OTEL_SERVICE_NAMESPACE=mcp
# DEPLOY_ENV=local
# OTEL_SERVICE_VERSION=
