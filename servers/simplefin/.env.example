# SimpleFIN Access URL from Bridge claim.
# A real claim URL embeds HTTP Basic Auth credentials — paste the full claimed
# URL into .env locally. Leave empty here; never commit a real Access URL.
# Claim flow: https://bridge.simplefin.org/simplefin/create then POST the token.
SIMPLEFIN_ACCESS_URL=

# Optional HTTP timeout in milliseconds (default 15000)
# SIMPLEFIN_TIMEOUT_MS=15000

# Day bounds for start/end use this IANA timezone (default America/Chicago)
# USER_TIMEZONE=America/Chicago

# HTTP listen (defaults shown)
# PORT=8798
# HOST=0.0.0.0

# OpenTelemetry configuration (metrics/logs → CreaGrafana Alloy)
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable telemetry; omit to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=simplefin
# OTEL_SERVICE_NAMESPACE=mcp
# DEPLOY_ENV=local
# OTEL_SERVICE_VERSION=
