# CreaDashboard base URL (no trailing path). Production default: http://192.168.1.135:3080
DASHBOARD_API_URL=http://192.168.1.135:3080

# HTTP request timeout in milliseconds
# DASHBOARD_API_TIMEOUT_MS=10000

# Month labels use this IANA timezone
# USER_TIMEZONE=America/Chicago

# OpenTelemetry configuration (metrics/logs → CreaGrafana Alloy)
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable telemetry; omit to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=utilities
# OTEL_SERVICE_NAMESPACE=mcp
# DEPLOY_ENV=local
# OTEL_SERVICE_VERSION=
