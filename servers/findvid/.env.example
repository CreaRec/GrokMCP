# Findvid MCP — reuse GramJS identity from CreaVideoDownloaderBot.
# Never commit real sessions, API hashes, or bot tokens.

# Option A: point at the downloader settings.json (preferred — no second login)
# TELEGRAM_SETTINGS_PATH=/path/to/CreaVideoDownloaderBot/config/settings.json
# TELEGRAM_USER_ID=123456789

# Option B: export the same values into env
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Findvid VIP inline bot (default fvidBot). Captions may show @fvid_try_bot.
FINDVID_BOT_USERNAME=fvidBot
# FINDVID_INLINE_BOT_USERNAME=fvid_try_bot

# CreaVideoDownloaderBot username without @ (also read from settings.telegram.botUsername)
DOWNLOADER_BOT_USERNAME=

# Defaults: prefer «Дублированный» then 1080p
# FINDVID_PREFERRED_VOICEOVER=Дублированный
# FINDVID_PREFERRED_QUALITIES=1080p,720p,480p

# Wait for Findvid replies / final video (ms)
# FINDVID_WAIT_TIMEOUT_MS=120000
# FINDVID_POLL_INTERVAL_MS=1500

# HTTP listen (defaults shown)
# PORT=8800
# HOST=0.0.0.0

# OpenTelemetry configuration (metrics/logs → CreaGrafana Alloy)
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable telemetry; omit to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=findvid
# OTEL_SERVICE_NAMESPACE=mcp
# DEPLOY_ENV=local
# OTEL_SERVICE_VERSION=
